# API anahtarları — bu dosyayı .env olarak kopyalayıp doldurun.
# .env dosyasını ASLA git'e commit etmeyin. Anahtarlar yalnız ortamdan okunur.
# Public OHLCV verisi için anahtar GEREKMEZ; anahtarlar yalnız hesap-özel
# veri ve (bilinçli aktive edilirse) canlı emir içindir.
# Bu dosya agi_trader/providers.py kataloğundan üretilir.


# --- 🏦 Borsa (public veri anahtarsız · ücretsiz API ile hesap/özel veri) ---
# Binance  -> https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_SECRET=
# Bybit  -> https://www.bybit.com/app/user/api-management
BYBIT_API_KEY=
BYBIT_SECRET=
# OKX  (pasaparola gerekir)  -> https://www.okx.com/account/my-api
OKX_API_KEY=
OKX_SECRET=
OKX_PASSWORD=
# Kraken  -> https://www.kraken.com/u/security/api
KRAKEN_API_KEY=
KRAKEN_SECRET=
# Coinbase  -> https://www.coinbase.com/settings/api
COINBASE_API_KEY=
COINBASE_SECRET=
# KuCoin  (pasaparola gerekir)  -> https://www.kucoin.com/account/api
KUCOIN_API_KEY=
KUCOIN_SECRET=
KUCOIN_PASSWORD=
# Gate.io  -> https://www.gate.io/myaccount/api_key_manage
GATEIO_API_KEY=
GATEIO_SECRET=
# Bitget  (pasaparola gerekir)  -> https://www.bitget.com/account/newapi
BITGET_API_KEY=
BITGET_SECRET=
BITGET_PASSWORD=
# MEXC  -> https://www.mexc.com/user/openapi
MEXC_API_KEY=
MEXC_SECRET=
# HTX (Huobi)  -> https://www.htx.com/en-us/apikey/
HTX_API_KEY=
HTX_SECRET=

# --- 📊 Piyasa Verisi (ücretsiz API) ---
# CoinGecko  (ücretsiz Demo planı: ~30 çağrı/dk)  -> https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY=
# CoinMarketCap  (ücretsiz Basic planı: 10k çağrı/ay)  -> https://pro.coinmarketcap.com/account
COINMARKETCAP_API_KEY=
# CryptoCompare  (ücretsiz: ~100k çağrı/ay)  -> https://www.cryptocompare.com/cryptopian/api-keys
CRYPTOCOMPARE_API_KEY=

# --- 🐋 On-chain (ücretsiz API) ---
# Etherscan  (ETH/ERC-20 büyük transfer + borsa cüzdan etiketi)  -> https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
# BscScan  (BNB Chain zincir-üstü veriler)  -> https://bscscan.com/myapikey
BSCSCAN_API_KEY=
# Blockchain.com  (BTC zincir-üstü büyük transferler)  -> https://www.blockchain.com/explorer/api
BLOCKCHAINCOM_API_KEY=

# --- 🐋 On-chain (premium) ---
# Whale Alert  ($29.95/ay — entity-etiketli balina transferleri)  -> https://whale-alert.io/
WHALE_ALERT_API_KEY=

# --- 🐦 Sosyal Sinyal ---
# Twitter / X  (canlı sosyal ısı — ücretli API)  -> https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=
# CryptoPanic  (ücretsiz kripto haber/sentiment akışı)  -> https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=
# LunarCrush  (sosyal medya metrikleri — ücretsiz 1000/gün)  -> https://lunarcrush.com/developers/api
LUNARCRUSH_API_KEY=

# --- 📉 Makro & Haber (ücretsiz API) ---
# FRED (St. Louis Fed)  (FED faizi, CPI, işsizlik, GSYİH — makro katmanını CANLI yapar)  -> https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
# NewsAPI  (80K+ kaynaktan haber başlığı — ücretsiz 100/gün)  -> https://newsapi.org/register
NEWSAPI_API_KEY=

# --- 🔔 Bildirim (işlem adayında uyarı) ---
# Telegram  (@BotFather ile ücretsiz bot oluştur)  -> https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord  (kanal ayarlarından ücretsiz webhook)  -> https://support.discord.com/hc/en-us/articles/228383668
DISCORD_WEBHOOK_URL=
# TradingView Webhook  (strateji alarmından POST /api/webhook/tradingview — gizli anahtar doğrulaması)  -> https://www.tradingview.com/support/solutions/43000529348-webhooks/
TRADINGVIEW_WEBHOOK_SECRET=

# --- 🤖 LLM (derin tweet/haber analizi) ---
# Anthropic (Claude)  -> https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# DeepSeek  (düşük maliyetli LLM)  -> https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
